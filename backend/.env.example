# Copy to backend/.env — required for the running API (validated in src/config/env.js)

# Database
DATABASE_URL=mysql://root:CHANGE_ME@localhost:3306/triton
# DATABASE_POOL_MAX=10
# DATABASE_SSL_CA_PATH=./aiven-ca.pem

# Server
PORT=5000
NODE_ENV=development

# Auth (openssl rand -hex 64)
JWT_ACCESS_SECRET=GENERATE_WITH_openssl_rand_hex_64
JWT_REFRESH_SECRET=GENERATE_SEPARATE_SECRET_WITH_openssl_rand_hex_64
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Security
# BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_API_MAX=120

# Uploads (local)
STORAGE_PROVIDER=local
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_MB=5
# ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Cloudflare R2 — set STORAGE_PROVIDER=r2 and fill these
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_PUBLIC_BASE_URL=

# Logging
# LOG_LEVEL=info

# ── Setup scripts only (npm run db:setup) — not read by env.js ──
# INSTITUTE_NAME=My Institute
# DATABASE_NAME=triton
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@myinstitute.local
# ADMIN_PASSWORD=choose_a_strong_password_min_8_chars
# MYSQL_ROOT_PASSWORD=your_mysql_root_password
